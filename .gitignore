# Accounts, sessions, ideas and looks (STUDIO_DATA default). Anchored so that
# public/data/cathedral.json stays tracked.
/data/
# tools/backup.ts archives (default --out)
/backups/
# npm ci installs these; npm run build writes the app here
/node_modules/
/dist/
# The Pi's own settings and looks (pi/README.md): git pull never touches them
/pi/config.json
/pi/light.json
/pi/local/
# Rendered shows, Python's caches and macOS's folder files
*.fseq
__pycache__/
*.pyc
.DS_Store
