// oxlint's half of `npm run lint` (tools/budgets.ts is the rest); CONTRIBUTING "The rules, and why" says why.
// Overrides apply in order, and an override's options replace the base's, so each one restates its whole list.
{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "vitest"],
  "categories": { "correctness": "error", "suspicious": "error" },
  "options": { "reportUnusedDisableDirectives": "error" },
  // The Pi's control page as built (committed: the Pi installs no Vite).
  "ignorePatterns": ["pi/page/dist/**"],
  "rules": {
    "max-lines": ["error", { "max": 400 }],
    "no-eval": "error",
    "no-new-func": "error",
    "no-implied-eval": "error",
    "no-debugger": "error",
    "unicorn/prefer-node-protocol": "error",
    "vitest/no-focused-tests": "error",
    "no-restricted-imports": ["error", { "paths": [
      { "name": "node:vm", "message": "code generation lives only in the pattern compiler and the render box" },
      { "name": "node:child_process", "message": "processes only box untrusted work" }
    ] }],
    // `const { data, ...stats } = baked` drops a key on purpose.
    "no-unused-vars": ["error", { "ignoreRestSiblings": true }],
    // Noise here, each for its reason:
    "no-underscore-dangle": "off",                       // `_row`, `_update`: a class's internal members
    "no-shadow": "off",                                  // a nested `list` or `label` is the clearest name
    "unicorn/consistent-function-scoping": "off",        // a helper sits beside its one caller
    "unicorn/no-array-sort": "off",                      // they sort fresh arrays; toSorted() would copy again
    "unicorn/no-array-reverse": "off",                   // likewise toReversed()
    "unicorn/no-new-array": "off",                       // `new Array(n).fill(0)` is the clear way to size one
    "unicorn/prefer-add-event-listener": "off",          // a MessagePort's onmessage setter also starts the port
    "unicorn/require-post-message-target-origin": "off"  // every postMessage goes to a Worker or a port
  },
  "overrides": [
    {
      "files": ["src/**", "server.ts"],
      "rules": {
        "no-restricted-imports": ["error", {
          "paths": [
            { "name": "node:vm", "message": "code generation lives only in the pattern compiler and the render box" },
            { "name": "node:child_process", "message": "processes only box untrusted work" }
          ],
          "patterns": [{ "group": ["**/public/**", "!**/public/js/pattern-core.*", "!**/public/js/fseq.*",
            "!**/public/js/scrub.*", "!**/public/**/*.json"], "message": "server code takes only pattern-core, fseq, scrub and data from public/" }]
        }]
      }
    },
    {
      // The render box and its limits, the Fleet foundry, and the generators' one-shot CLI calls (no shell).
      "files": ["src/render-box.ts", "src/box-limits.ts", "src/generate/fleet.ts", "src/generate/proc.ts"],
      "rules": {
        "no-restricted-imports": ["error", {
          "paths": [
            { "name": "node:vm", "message": "code generation lives only in the pattern compiler and the render box" }
          ],
          "patterns": [{ "group": ["**/public/**", "!**/public/js/pattern-core.*", "!**/public/js/fseq.*",
            "!**/public/js/scrub.*", "!**/public/**/*.json"], "message": "server code takes only pattern-core, fseq, scrub and data from public/" }]
        }]
      }
    },
    {
      "files": ["public/**"],
      "rules": {
        "no-restricted-imports": ["error", {
          "paths": [
            { "name": "node:vm", "message": "code generation lives only in the pattern compiler and the render box" },
            { "name": "node:child_process", "message": "processes only box untrusted work" }
          ],
          "patterns": [
            { "regex": "^\\.{1,2}/(?:.*/)?(?:src|render-box|fleet-box|tools|test)/|^\\.{1,2}/(?:.*/)?server\\.[jt]s$",
              "message": "browser code imports only from public/ and packages" },
            { "regex": "^(?:[a-z]+:)?//", "message": "remote URL: the app runs offline under a self-only CSP" },
            // All of shared/ but idea-status.ts, plays.ts and standard-modules.ts, which are pure (the regex has no
            // look-ahead: "not id…, not pl…, not st…").
            { "regex": "^\\.{1,2}/(?:.*/)?shared/(?:[^ips]|i[^d]|p[^l]|s[^t])", "allowTypeImports": true,
              "message": "browser code takes shared/ schemas as types (import type), so zod is not shipped by accident; shared/idea-status.ts, shared/plays.ts and shared/standard-modules.ts are pure" }
          ]
        }]
      }
    },
    {
      // The schemas are shared with the browser: zod, the core's constants and data, nothing of the server's.
      "files": ["shared/**"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [
          { "regex": "^node:", "message": "shared/ runs in the browser too: no Node built-ins" },
          { "regex": "^\\.{1,2}/(?:.*/)?(?:src|render-box|fleet-box|tools|test)/|^\\.{1,2}/(?:.*/)?server\\.[jt]s$",
            "message": "shared/ imports only zod, itself and the core's constants and data from public/" },
          { "group": ["**/public/**", "!**/public/js/pattern-core.*", "!**/public/**/*.json"],
            "message": "shared/ imports only zod, itself and the core's constants and data from public/" }
        ] }]
      }
    },
    {
      // What plays runs in the browser as well as on the server: shared/'s rules, and no zod or schemas.
      "files": ["shared/plays.ts"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [
          { "regex": "^zod$|/schemas/", "message": "shared/plays.ts is the browser's at run time: no zod, no schemas" },
          { "regex": "^node:", "message": "shared/ runs in the browser too: no Node built-ins" },
          { "group": ["**/public/**", "!**/public/js/pattern-core.*"],
            "message": "shared/plays.ts imports only the core's constants" }
        ] }]
      }
    },
    {
      "files": ["src/**", "shared/**", "public/js/**"],
      "rules": { "no-console": ["error", { "allow": ["warn", "error"] }] }
    },
    {
      "files": ["public/js/**"],
      "rules": {
        "no-restricted-properties": ["error",
          { "property": "innerHTML", "message": "HTML string sink: build nodes with JSX, text as text" },
          { "property": "outerHTML", "message": "HTML string sink: build nodes with JSX, text as text" },
          { "property": "insertAdjacentHTML", "message": "HTML string sink: build nodes with JSX, text as text" },
          { "object": "document", "property": "write", "message": "HTML string sink: build nodes with JSX" },
          { "object": "document", "property": "writeln", "message": "HTML string sink: build nodes with JSX" }
        ]
      }
    },
    {
      "files": ["public/js/pattern-core.*", "public/js/core/**"],
      "rules": {
        "no-restricted-properties": ["error",
          { "property": "innerHTML", "message": "HTML string sink: build nodes with JSX, text as text" },
          { "property": "outerHTML", "message": "HTML string sink: build nodes with JSX, text as text" },
          { "property": "insertAdjacentHTML", "message": "HTML string sink: build nodes with JSX, text as text" },
          { "object": "document", "property": "write", "message": "HTML string sink: build nodes with JSX" },
          { "object": "document", "property": "writeln", "message": "HTML string sink: build nodes with JSX" },
          { "object": "Math", "property": "random", "message": "bakes are deterministic: use rand, hash, noise, seed" }
        ]
      }
    },
    {
      "files": ["render-box/**", "public/patterns/**"],
      "rules": {
        "no-restricted-properties": ["error",
          { "object": "Math", "property": "random", "message": "bakes are deterministic: use rand, hash, noise, seed" }
        ]
      }
    },
    {
      // Library patterns are scripts the compiler reads by name, and their signatures are the API the AI copies.
      "files": ["public/patterns/**", "test/fixtures/generate/library/**"],
      "rules": {
        "no-unused-vars": ["error", { "varsIgnorePattern": "^(?:params|pixel|warp|filter|frame|spatial|stage|history|upgrade)$", "args": "none" }]
      }
    },
    { "files": ["public/patterns/**"], "rules": { "max-lines": ["error", { "max": 150 }] } },
    // The allowlist: the pattern compiler, the render box, and the processes that box untrusted work.
    { "files": ["public/js/core/compile.ts"], "rules": { "no-new-func": "off" } },
    {
      "files": ["render-box/render.ts"],
      "rules": { "no-restricted-imports": ["error", { "paths": [
        { "name": "node:child_process", "message": "processes only box untrusted work" }
      ] }] }
    },
    { "files": ["tools/**", "pi/tools/**"], "rules": { "no-restricted-imports": "off" } },
    {
      // Tests may run code and processes; they are outside the capability rules.
      "files": ["test/**", "pi/test/**"],
      "rules": {
        "max-lines": ["error", { "max": 600 }],
        "no-restricted-imports": "off", "no-eval": "off", "no-new-func": "off", "no-implied-eval": "off",
        "unicorn/no-invalid-fetch-options": "off",  // helpers pass `method` through; it reads a variable as GET
        "no-unmodified-loop-condition": "off",      // `while (writing)`: another async task clears the flag
        // A case's test is named by the case, in a loop over the library or the rigs.
        "vitest/valid-title": ["error", { "ignoreTypeOfTestName": true }],
        // node:assert asserts, and so do the tests' own helpers that wrap it.
        "vitest/expect-expect": ["error", { "assertFunctionNames": ["expect", "assert", "assert.*", "near", "nearC",
          "check"] }]
      }
    },
    {
      // Playwright Test specs (`npm run smoke`, `perf`, `e2e`): its own test API, which oxlint has no plugin for.
      // `.only` stays an error there too.
      "files": ["test/e2e/**"],
      "rules": {
        "vitest/expect-expect": "off", "vitest/hoisted-apis-on-top": "off", "vitest/no-commented-out-tests": "off",
        "vitest/no-conditional-expect": "off", "vitest/no-conditional-tests": "off", "vitest/no-disabled-tests": "off",
        "vitest/no-standalone-expect": "off", "vitest/prefer-snapshot-hint": "off",
        "vitest/require-awaited-expect-poll": "off",
        "vitest/require-local-test-context-for-concurrent-snapshots": "off",
        "vitest/require-mock-type-parameters": "off", "vitest/require-to-throw-message": "off",
        "vitest/valid-describe-callback": "off", "vitest/valid-expect": "off", "vitest/valid-expect-in-promise": "off",
        "vitest/valid-title": "off", "vitest/warn-todo": "off"
      }
    }
  ]
}
