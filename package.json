{
  "name": "folly-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Folly Studio: turn show ideas into pattern code and preview them on the Gothic Folly.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "prestart": "vite build",
    "start": "node server.js",
    "dev": "node tools/dev.mjs",
    "build": "vite build",
    "typecheck": "tsc -p .",
    "lint": "node tools/lint.mjs",
    "test": "node --test \"test/**/*.test.{js,ts}\"",
    "check": "npm run typecheck && npm run lint && npm test",
    "e2e": "node test/e2e/run.mjs",
    "perf": "node test/e2e/perf.mjs",
    "backup": "node tools/backup.mjs",
    "build-data": "python3 tools/build_rig.py && python3 tools/build_palettes.py"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
