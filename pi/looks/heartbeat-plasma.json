{
  "title": "Heartbeat plasma",
  "duration": 60,
  "bpm": 120,
  "globals": {
    "macros": { "drive": { "value": 0.4, "min": 0, "max": 1 }, "ripple": { "value": 0.25, "min": 0, "max": 1 } },
    "live": ["bpm", "drive", "ripple", "hue", "level"]
  },
  "layers": [
    { "modules": [{ "ref": "plasma", "params": { "speed": { "mod": "global", "name": "drive", "from": 0.016, "to": 0.24 } } }] },
    { "blend": "add", "level": 0.5, "modules": [{ "ref": "heartbeat",
      "params": { "colours": "all", "spread": { "mod": "global", "name": "ripple", "from": 0.6, "to": 1.2 } } }] }
  ]
}
