#!/usr/bin/env node
// Stands in for the Codex CLI in the codex adapter's tests and the smoke check: `codex exec … -o <file> -`, no network.
// It reads the prompt from stdin, logs its arguments to CODEX_FAKE_LOG (a JSON line), and per CODEX_FAKE_MODE:
// ok (default) writes a look to the -o file; slow does so after CODEX_FAKE_DELAY ms; bad writes something not JSON;
// fail exits 2; term is stopped by SIGTERM (a service stop reaching it); huge writes a 600 KB answer; flood floods stdout; hang starts a child (its pid to CODEX_FAKE_PIDS)
// and waits forever; stall-once says nothing and waits forever the first time (CODEX_FAKE_PIDS.stalled marks it),
// then answers. A draft turn (SPEC-generators "Explore") is answered with three takes and a synthesis; a refinement
// with one edit of its first layer's level, or with nothing usable when it asks for a poem. With
// --json, its events go to stdout as the real one's do: a reasoning item (CODEX_FAKE_THINKING's first, if set) before
// it answers, then the turn's usage.
import { spawn } from 'node:child_process';
import { appendFileSync, existsSync, writeFileSync } from 'node:fs';

const args = process.argv.slice(2), mode = process.env.CODEX_FAKE_MODE || 'ok';
const after = (flag) => args[args.indexOf(flag) + 1];
let prompt = '';
process.stdin.setEncoding('utf8');
process.stdin.on('data', (d) => { prompt += d; });
process.stdin.on('end', async () => {
  if (process.env.CODEX_FAKE_LOG) {
    appendFileSync(process.env.CODEX_FAKE_LOG, `${JSON.stringify({ args, cwd: process.cwd(), prompt: prompt.length,
      idea: /<idea>\n([^]*?)\n<\/idea>/.exec(prompt)?.[1] ?? null, env: Object.keys(process.env).sort() })}\n`);
  }
  const out = after('-o');
  const look = { plan: 'One slow blue layer over the whole cathedral.', title: 'Codex sky',
    summary: 'Blue light drifting.', duration: null, globals: null, automation: null,
    layers: [{ title: 'Sky', why: 'a sky drifts', groups: ['cathedral'], tags: [], blend: 'add', level: 1, clips: null,
      modules: null,
      code: `const params = {
  colours: { value: 'all', type: 'color', label: 'Colours', help: 'The colours it drifts through.' },
  speed: { value: 0.1, min: 0, max: 1, step: 0.01, label: 'Speed', help: 'How fast it drifts.' },
};
function pixel(p, t, P) {
  return pal('colours', wave(p.ly - t * P.speed));
}
` }] };
  if (mode === 'term') process.kill(process.pid, 'SIGTERM');
  if (mode === 'fail') { process.stderr.write('error: the model is not available\n'); process.exit(2); }
  if (mode === 'bad') writeFileSync(out, 'Here is your look: it is lovely.');
  if (mode === 'huge') writeFileSync(out, JSON.stringify({ ...look, summary: 'x'.repeat(600 * 1024) }));
  if (mode === 'flood') for (let i = 0; i < 64; i++) process.stdout.write('.'.repeat(64 * 1024));
  const stall = `${process.env.CODEX_FAKE_PIDS}.stalled`;
  if (mode === 'stall-once' && !existsSync(stall)) {
    writeFileSync(stall, String(process.pid));
    setInterval(() => {}, 1000);
    return;
  }
  if (mode === 'hang') {
    const child = spawn(process.execPath, ['-e', 'setInterval(() => {}, 1000)'], { stdio: 'ignore' });
    writeFileSync(process.env.CODEX_FAKE_PIDS, `${process.pid} ${child.pid}`);
    setInterval(() => {}, 1000);
    return;
  }
  const json = args.includes('--json'), say = (events) => {
    if (json) process.stdout.write(events.map((e) => `${JSON.stringify(e)}\n`).join(''));
  };
  const thought = (id, text) => [{ type: 'item.started', item: { id, type: 'reasoning', text: '' } },
    { type: 'item.completed', item: { id, type: 'reasoning', text } }];
  say([{ type: 'thread.started', thread_id: 't1' }, { type: 'turn.started' },
    ...(process.env.CODEX_FAKE_THINKING ? thought('item_t', process.env.CODEX_FAKE_THINKING) : []),
    ...thought('item_0', 'Blue, slow.')]);
  if (mode === 'slow') await new Promise((r) => setTimeout(r, Number(process.env.CODEX_FAKE_DELAY) || 200));
  const take = (name) => ({ name, lead: 'the spires', motion: 'drifting', scale: 'one gesture', colour: 'blue',
    tempo: 'slow', take: `${name}: blue light drifts up the spires.` });
  const drafts = { takes: ['Tide', 'Haze', 'Dusk'].map(take),
    synthesis: { took: 'the drift from Tide, the blue from Haze', brief: 'Blue light drifts up the spires.' } };
  const request = /<request>\n([^]*?)\n<\/request>/.exec(prompt)?.[1];
  const edits = { edits: [{ op: 'set', path: 'layers/0/level', value: 0.7, why: 'as asked' }] };
  const answer = /Before composing a look, draft/.test(prompt) ? drafts : request ? edits : look;
  if (/poem/.test(request ?? '')) writeFileSync(out, 'A poem is not a look.');
  else if (mode === 'ok' || mode === 'slow' || mode === 'stall-once') writeFileSync(out, JSON.stringify(answer));
  say([{ type: 'turn.completed', usage: { input_tokens: 1200, cached_input_tokens: 1000, output_tokens: 80,
    reasoning_output_tokens: 30 } }]);
});
